# ============================================================
# 企業訂餐系統 — 環境變數設定
# 複製此檔案為 .env 並填入實際值
# ============================================================

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ── 資料庫 ───────────────────────────────────────────────────
# Docker Compose 模式：不需要填 RDS 相關設定
# RDS 模式（EC2 + PM2）：填入 RDS endpoint

DB_USER=myuser
DB_PASSWORD=mypassword

# RDS 模式才需要填：
RDS_HOST=your-db.xxxxxx.us-east-1.rds.amazonaws.com
RDS_USER=postgres
RDS_PASS=your_rds_master_password
RDS_PORT=5432

# EC2 的 Elastic IP（用於 email 驗證連結）
EC2_HOST=your-elastic-ip

# ── Email (Gmail) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=your_email@gmail.com

# ── 跨服務呼叫 ───────────────────────────────────────────────
INTERNAL_ADMIN_EMAIL=admin1@test.com
INTERNAL_ADMIN_PASSWORD=admin123

# 跟其他組對齊後填入
ORDER_SERVICE_URL=http://localhost:3006
MENU_SERVICE_URL=http://localhost:3007
