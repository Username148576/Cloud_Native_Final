{
  "name": "ordering-system-services",
  "version": "1.0.0",
  "private": true,
  "description": "企業訂餐系統微服務根目錄",
  "scripts": {
    "test": "npm run test:iam && npm run test:notification && npm run test:recommendation && npm run test:billing && npm run test:appeal",
    "test:iam": "npm --prefix iam test",
    "test:notification": "npm --prefix notification test",
    "test:recommendation": "npm --prefix recommendation test",
    "test:billing": "npm --prefix billing test",
    "test:appeal": "npm --prefix appeal-admin test",
    "smoke:health": "node scripts/smoke-health.js",
    "deploy": "bash scripts/deploy.sh",
    "deploy:init": "bash scripts/deploy.sh --init",
    "deploy:promtail": "bash scripts/deploy-promtail.sh",
    "dev:iam": "cd iam && npm run dev",
    "dev:notification": "cd notification && npm run dev",
    "dev:recommendation": "cd recommendation && npm run dev",
    "dev:billing": "cd billing && npm run dev",
    "dev:appeal": "cd appeal-admin && npm run dev"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3"
  }
}
